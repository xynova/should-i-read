# Copy to config/emailops-polypus.env (gitignored). Mailbox OAuth secrets stay in
# providers/emailops/.env.local (not committed).

# ---------------------------------------------------------------------------
# Polypus gateway (required)
# ---------------------------------------------------------------------------
# Downstream apps MUST call only this base URL. Do not set OpenRouter, Ollama,
# Cloudflare, or LM Studio URLs in EmailOps client config for this host.
POLYPUS_BASE_URL=http://127.0.0.1:1320

# ---------------------------------------------------------------------------
# EmailOps black-box (host CLI)
# ---------------------------------------------------------------------------
# Platform default is used when unset (macOS Application Support/com.emailops.app).
# Do NOT rely on providers/emailops/.emailops-data unless you set it on purpose.
# EMAILOPS_DATA_DIR=/absolute/path/to/com.emailops.app
# Optional explicit binary (else PATH or cargo debug under providers/emailops):
# EMAILOPS_CLI=/usr/local/bin/emailops-cli

# Fail closed: do not use EmailOps embedded llama.cpp, OpenRouter, or Ollama
# for this host's product AI. Host Go + Polypus only.
EMAILOPS_AI_VIA_POLYPUS=1
EMAILOPS_ALLOW_EMBEDDED_LLAMACPP=0
EMAILOPS_ALLOW_DIRECT_OPENROUTER=0
EMAILOPS_ALLOW_DIRECT_OLLAMA=0

# ---------------------------------------------------------------------------
# Model ids for future host AI (must match Polypus allow-list with backend prefix)
# ---------------------------------------------------------------------------
# Examples only; replace with ids from:
#   ./bin/should-i-read polypus check
EMAILOPS_CHAT_MODEL=cf_local/@cf/google/gemma-4-26b-a4b-it
EMAILOPS_CLASSIFY_MODEL=cf_local/@cf/google/gemma-4-26b-a4b-it
EMAILOPS_EMBED_MODEL=lm_studio/text-embedding-nomic-embed-text-v1.5

# ---------------------------------------------------------------------------
# Report-only unwanted-mail path (Jev follow-up; no mailbox writes)
# ---------------------------------------------------------------------------
EMAILOPS_UNWANTED_MODE=report_only
# EMAILOPS_JEV_MODEL=jev-1.13.0
# TYPESAFE_API_KEY=   # never commit; inject via Polypus backend when Jev is wired
