# Optional: set POLYPUS_BASE_URL in the shell when testing a remote gateway.
# Prefer polypus.base_url in ~/.config/should-i-read/config.yaml (see: should-i-read config bump).
#
# POLYPUS_BASE_URL=https://your-polypus.example
# Probe: go tool task polypus-check
# Classify smoke: go tool task polypus-check -- --classify
